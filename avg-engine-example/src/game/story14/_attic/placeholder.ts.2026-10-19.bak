/**
 * 《雪见庄·长夜》story14 占位图
 *
 * 当前阶段（Step 4 A 机已接入背景/物件，B 机立绘/CG/序列帧/音频待出）：
 *   - 已落盘 public/images/{bg,items}/xuejian/ 的真实资源保持原 url（引擎直接渲染）；
 *   - MISSING_KEYS 中的 key（CG 18 + 序列帧 8 + 立绘 51）替换为占位色块 data URI，便于核对站位/分镜；
 *   - 音频不在此列：引擎 loadAudio 已改为缺失静音跳过（不依赖占位），避免 init 崩溃。
 *
 * Step 4 B 机出图后：把对应 key 从 MISSING_KEYS 移除即可（无需改脚本）。
 */
import type { AssetManifest } from '../../engine/types';

// —— 缺失清单（精确对齐当前 manifest + 磁盘真实文件，2026-10-18 重写）——
// 规则：已落盘 public/images/{bg,items}/xuejian/ 的 key 不在此列；
//   其余（CG 18 + 序列帧 8 + 立绘 51）为 B 机(qwen)待出，标记为占位。
// 音频不在此列：引擎 loadAudio 已改为缺失静音跳过（不依赖占位）。
// B 机出图后：把对应 key 从 MISSING_KEYS 移除即可（无需改脚本）。
export const MISSING_KEYS = new Set<string>([
  // 序列帧 8（anim_fire / anim_snow 各 4）
  'anim_fire_0', 'anim_fire_1', 'anim_fire_2', 'anim_fire_3',
  'anim_snow_0', 'anim_snow_1', 'anim_snow_2', 'anim_snow_3',
  // CG 18
  'cg_bloodletter', 'cg_bracelet', 'cg_burn_pool', 'cg_ch1_drowning',
  'cg_ch2_footprints', 'cg_ch4_medicine', 'cg_ch5_stable_talk', 'cg_ch6_symbol',
  'cg_epilogue_snow', 'cg_knife_sheath', 'cg_memory_20y', 'cg_ngplus_origin',
  'cg_prologue_gate', 'cg_prologue_trek', 'cg_routeA_ledger', 'cg_routeB_orphan_wife',
  'cg_routeC_knife', 'cg_sigil_wax',
  // 立绘 pose（8 角色共用本词表；B 机出图后按需在下方移除对应 pose）
  'amused', 'bitter', 'close', 'cold', 'curious', 'dead', 'default', 'draw',
  'drunk', 'grief', 'guilty', 'lookup', 'old', 'resolve', 'sad', 'serious',
  'sharp', 'shock', 'smug', 'soft', 'tense', 'think', 'worried', 'wry',
]);

/** 生成占位图 data URI（纯色块 + 文字）。
 * 关键修复：改用 canvas 生成的真实 PNG data URL，而非 SVG data URI。
 * SVG data URI 在 canvas 上 drawImage 时部分浏览器会判定为 0 尺寸图片并抛异常，
 * 导致主循环在序章首帧（CG 占位图）崩死→整屏黑。PNG data URL 带真实尺寸，100% 可绘制。 */
export function createPlaceholder(label: string, color = '#3a4a5a'): string {
  const w = 1280, h = 720;
  const canvas = document.createElement('canvas');
  canvas.width = w;
  canvas.height = h;
  const ctx = canvas.getContext('2d');
  if (!ctx) return '';
  ctx.fillStyle = color;
  ctx.fillRect(0, 0, w, h);
  ctx.fillStyle = 'rgba(255,255,255,0.85)';
  ctx.font = '28px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(label, w / 2, h / 2);
  return canvas.toDataURL('image/png');
}

const BG_COLOR = '#2b3540';
const SPRITE_COLOR = '#3a4250';
const CG_COLOR = '#1f2730';

/** 把 manifest 中缺失的 key 替换为占位 data URI（已落盘的真实资源保持原 url） */
export function fillPlaceholders(manifest: AssetManifest): AssetManifest {
  const out: AssetManifest = JSON.parse(JSON.stringify(manifest));

  // 背景 / CG / 序列帧：缺失的标占位（CG 用更暗色块区分）
  const patchBg = (rec: Record<string, any>) => {
    for (const key of Object.keys(rec)) {
      if (MISSING_KEYS.has(key)) {
        const isCg = key.startsWith('cg_');
        rec[key] = createPlaceholder(isCg ? 'CG·' + key : '背景·' + key, isCg ? CG_COLOR : BG_COLOR);
      }
    }
  };
  patchBg(out.backgrounds as any);

  // 立绘：缺失 pose 标占位（标签含 角色_pose，便于核对站位）
  for (const ch of Object.keys(out.sprites)) {
    const set = (out.sprites as any)[ch];
    for (const pose of Object.keys(set)) {
      if (MISSING_KEYS.has(pose)) {
        set[pose] = createPlaceholder('立绘·' + ch + '_' + pose, SPRITE_COLOR);
      }
    }
  }

  // 物件：已落盘真实文件，保持原 url（renderer 对 404 静默，无需占位）
  return out;
}
